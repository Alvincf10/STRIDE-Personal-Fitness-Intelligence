# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# Single-user auth
APP_USERNAME=owner
APP_PASSWORD=change-me
AUTH_SECRET=replace-with-32-plus-char-random-string

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/garmin_fitness

# AES-256-GCM key: 32 bytes as base64
ENCRYPTION_KEY=

# Garmin Personal API
# API key is stored encrypted via Settings UI; do not put the key here.
GARMIN_API_BASE_URL=https://personal.connectapi.garmin.com

# Sync defaults (minutes)
SYNC_ACTIVITIES_INTERVAL_MINUTES=30
SYNC_HEALTH_INTERVAL_MINUTES=120
